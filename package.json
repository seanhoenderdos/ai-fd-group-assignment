{
    "name": "ai-fd-group-assignment",
    "version": "1.0.0",
    "private": true,
    "description": "Shared development tools for the Prime Shine HTML and CSS assignment.",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "check": "npm run format:check && npm run lint"
    },
    "devDependencies": {
        "@eslint/css": "2.0.1",
        "@html-eslint/eslint-plugin": "0.67.0",
        "eslint": "10.13.0",
        "prettier": "3.9.10"
    }
}
